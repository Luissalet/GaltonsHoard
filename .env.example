# Optional. Settings that can be changed in the app live in the database (data/galton.db); these are read at start.
# GALTON_PORT=5201
# GALTON_DATA_DIR=
# GALTON_ALLOWED_HOSTS=
# GALTON_HTTP_TIMEOUT_S=10
# Demo mode: fake GPUs and three models that answer from a table. Nothing real is touched; the routing table goes to data/routes-demo.json.
# GALTON_FAKE=1
# Where the routing table is published for Hoard Link (default: ~/.hoard/routes.json).
# HOARD_ROUTES_FILE=
# Do not look for models or probe servers (tests and tooling).
# GALTON_OFFLINE=1
# Do not start the background jobs (model refresh, regression watch, housekeeping). Runs you start still work.
# GALTON_SCHEDULER=0
# Token for the Faustus registry, if it asks for one.
# GALTON_FAUSTUS_TOKEN=
